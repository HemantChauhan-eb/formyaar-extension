{
  "form": "correction_pan_card",
  "version": 5,
  "site": "onlineservices.proteantech.in",
  "steps": [
    {
      "step": 1,
      "page_pattern": "endUserRegisterContact",
      "page": "registerEndUser",
      "fields": [
        {
          "field_id": "application_type",
          "type": "select",
          "selector": "#type",
          "value_source": "static",
          "static_value": "CR",
          "match_by": "value",
          "explanation": "PAN application type — Changes or Correction in existing PAN Data / Reprint of PAN Card. Must be filled first: NSDL only unhides the citizenship + PAN Number row (#rowCR) once this select fires change with CR."
        },
        {
          "field_id": "applicant_category",
          "type": "select",
          "selector": "#cat_applicant1",
          "value_source": "static",
          "static_value": "P",
          "match_by": "value",
          "min_delay_ms": 1000,
          "explanation": "Applicant category — Individual. Filled after application_type because NSDL's #type change handler rewrites this dropdown's options; 1s delay lets that finish before the name fields."
        },
        {
          "field_id": "first_name",
          "type": "text",
          "selector": "#f_name_end",
          "value_source": "user.first_name",
          "explanation": "Your first name as per your existing PAN."
        },
        {
          "field_id": "middle_name",
          "type": "text",
          "selector": "#m_name_end",
          "value_source": "user.middle_name",
          "explanation": "Your middle name as per your existing PAN."
        },
        {
          "field_id": "last_name",
          "type": "text",
          "selector": "#l_name_end",
          "value_source": "user.last_name",
          "explanation": "Your last name as per your existing PAN."
        },
        {
          "field_id": "date_of_birth",
          "type": "text",
          "selector": "#date_of_birth_reg",
          "value_source": "user.date_of_birth",
          "explanation": "Your date of birth in DD/MM/YYYY format."
        },
        {
          "field_id": "email",
          "type": "text",
          "selector": "#email_id2",
          "value_source": "user.email",
          "explanation": "Your email — your corrected ePAN will be sent here."
        },
        {
          "field_id": "mobile",
          "type": "text",
          "selector": "#rvContactNo",
          "value_source": "user.mobile",
          "explanation": "Your 10-digit mobile number."
        },
        {
          "field_id": "citizen_of_india",
          "type": "radio",
          "selector": "#citizenCr1",
          "value_source": "static",
          "static_value": true,
          "explanation": "Whether Citizen of India — Yes. Only visible after application_type is set to CR."
        },
        {
          "field_id": "consent",
          "type": "checkbox",
          "selector": "#consent",
          "value_source": "static",
          "static_value": true,
          "explanation": "Consent to data processing."
        }
      ],
      "completion": {
        "title": "Registration filled!",
        "subtitle": "Enter your PAN number, then generate your token",
        "manual_steps": [
          "Type your existing <strong>10-character PAN number</strong> in the PAN NUMBER box",
          "Solve the CAPTCHA and wait for the green check ✓",
          "Click <strong>Submit</strong>"
        ],
        "info": "Your token will appear on the next screen."
      },
      "page_coach": {
        "selector": "#submitForm",
        "message": "Enter your PAN number, solve the CAPTCHA, wait for the green check ✓, then click Submit"
      }
    },
    {
      "step": 1,
      "page_pattern": "registerEndUser",
      "page": "tokenGenerated",
      "stop_message": "Token generated. Clicking Continue to proceed.",
      "fields": [
        {
          "field_id": "continue_after_token",
          "type": "button_click",
          "selector": "#submitForm",
          "value_source": "static",
          "static_value": true,
          "explanation": "Continue past the token confirmation screen."
        }
      ]
    },
    {
      "step": 1,
      "page_pattern": "endUserLogin",
      "page": "tokenPage",
      "is_token_page": true,
      "stepy_index": -1,
      "stop_message": "Existing application found. Selecting your previous token.",
      "fields": [
        {
          "field_id": "existing_token",
          "type": "radio",
          "selector": "input.tokenButton",
          "value_source": "static",
          "static_value": true,
          "explanation": "Select existing token to resume previous application. NSDL's inline onclick enables the Use-above-Token button, which starts disabled."
        },
        {
          "field_id": "use_token_btn",
          "type": "button_click",
          "selector": "#submitForm11",
          "value_source": "static",
          "static_value": true,
          "explanation": "Click Use above Token to proceed."
        }
      ]
    },
    {
      "step": 2,
      "page_pattern": "endUserLogin",
      "page": "endUserLogin",
      "stepy_index": 1,
      "stop_message": "Personal details filled. Please verify and click Next.",
      "fields": [
        {
          "field_id": "submission_mode_ekyc",
          "type": "radio",
          "selector": "#eVerfication4",
          "value_source": "static",
          "static_value": true,
          "explanation": "Aadhaar-based eKYC & e-Sign (paperless). Already the page default; set explicitly so a changed default can't silently reroute the application."
        },
        {
          "field_id": "physical_pan_yes",
          "type": "radio",
          "selector": "#appli_epan_op1_y",
          "value_source": "user.wants_physical_pan",
          "static_value": "yes",
          "explanation": "Physical PAN card + ePAN (₹101)."
        },
        {
          "field_id": "physical_pan_no",
          "type": "radio",
          "selector": "#appli_epan_op1_n",
          "value_source": "user.wants_physical_pan",
          "static_value": "no",
          "explanation": "ePAN only, no physical card (₹66). Email becomes mandatory."
        },
        {
          "field_id": "update_flag_aadhaar",
          "type": "checkbox",
          "selector": "#checkBox_aadhaar",
          "value_source": "static",
          "static_value": true,
          "explanation": "Correction form only: the tick beside a section heading marks that section for change. Without it NSDL ignores whatever is typed below."
        },
        {
          "field_id": "aadhaar_last_4",
          "type": "text",
          "selector": "#aadhaarNo_2",
          "value_source": "user.aadhaar_last_4",
          "explanation": "Last 4 digits of your Aadhaar — the first 8 are masked and read-only."
        },
        {
          "field_id": "ekyc_photo_consent",
          "type": "select",
          "selector": "#consentEkyc",
          "value_source": "static",
          "static_value": "Y",
          "match_by": "value",
          "explanation": "Consent to print your Aadhaar photo on the PAN card."
        },
        {
          "field_id": "update_flag_name",
          "type": "checkbox",
          "selector": "#checkBox_title",
          "value_source": "static",
          "static_value": true,
          "explanation": "Marks Full Name of the Applicant for change."
        },
        {
          "field_id": "first_name_step2",
          "type": "text",
          "selector": "#f_name",
          "value_source": "user.first_name",
          "explanation": "First name as per Aadhaar."
        },
        {
          "field_id": "middle_name_step2",
          "type": "text",
          "selector": "#m_name",
          "value_source": "user.middle_name",
          "explanation": "Middle name as per Aadhaar."
        },
        {
          "field_id": "last_name_step2",
          "type": "text",
          "selector": "#l_name",
          "value_source": "user.last_name",
          "explanation": "Last name as per Aadhaar."
        },
        {
          "field_id": "update_flag_dob",
          "type": "checkbox",
          "selector": "#checkBox_date",
          "value_source": "static",
          "static_value": true,
          "explanation": "Marks Date of Birth for change. The date itself is read-only here — it carries over from the token registration."
        },
        {
          "field_id": "update_flag_gender",
          "type": "checkbox",
          "selector": "#checkBox_gender",
          "value_source": "static",
          "static_value": true,
          "explanation": "Marks Gender for change."
        },
        {
          "field_id": "gender",
          "type": "select",
          "selector": "#gender",
          "value_source": "user.gender",
          "match_by": "value",
          "explanation": "Your gender as per Aadhaar."
        },
        {
          "field_id": "update_flag_parents",
          "type": "checkbox",
          "selector": "#checkBox_parentName",
          "value_source": "static",
          "static_value": true,
          "explanation": "Marks Details of Parents for change. The single-parent radio inside this section is server-populated from the existing PAN, so it is deliberately not filled."
        },
        {
          "field_id": "father_first_name",
          "type": "text",
          "selector": "#faf_name",
          "value_source": "user.father_first_name",
          "explanation": "Father's first name."
        },
        {
          "field_id": "father_middle_name",
          "type": "text",
          "selector": "#fam_name",
          "value_source": "user.father_middle_name",
          "explanation": "Father's middle name."
        },
        {
          "field_id": "father_last_name",
          "type": "text",
          "selector": "#fal_name",
          "value_source": "user.father_last_name",
          "explanation": "Father's last name."
        },
        {
          "field_id": "mother_first_name",
          "type": "text",
          "selector": "#mof_name",
          "value_source": "user.mother_first_name",
          "explanation": "Mother's first name."
        },
        {
          "field_id": "mother_middle_name",
          "type": "text",
          "selector": "#mom_name",
          "value_source": "user.mother_middle_name",
          "explanation": "Mother's middle name."
        },
        {
          "field_id": "mother_last_name",
          "type": "text",
          "selector": "#mol_name",
          "value_source": "user.mother_last_name",
          "explanation": "Mother's last name."
        },
        {
          "field_id": "parent_on_card_father",
          "type": "radio",
          "selector": "#parent_father",
          "value_source": "user.parent_on_card_is_father",
          "explanation": "Print father's name on the PAN card."
        },
        {
          "field_id": "parent_on_card_mother",
          "type": "radio",
          "selector": "#parent_mother",
          "value_source": "user.parent_on_card_is_mother",
          "explanation": "Print mother's name on the PAN card."
        }
      ],
      "auto_advance": true
    },
    {
      "step": 3,
      "page_pattern": "endUserLogin",
      "page": "endUserLogin",
      "stepy_index": 2,
      "stop_message": "Contact details filled. Please verify and click Next.",
      "fields": [
        {
          "field_id": "update_flag_contact",
          "type": "checkbox",
          "selector": "#checkBox_tele",
          "value_source": "static",
          "static_value": true,
          "explanation": "Marks Contact Details for change. Must be ticked before the fields below are accepted."
        },
        {
          "field_id": "isd_code",
          "type": "select",
          "selector": "#tel_num_isdcode",
          "value_source": "static",
          "static_value": "91",
          "match_by": "value",
          "explanation": "Country code for the mobile number — India (91)."
        },
        {
          "field_id": "mobile_num",
          "type": "text",
          "selector": "#mobile_num",
          "value_source": "user.mobile",
          "explanation": "Your 10-digit mobile number."
        },
        {
          "field_id": "landline_isd_code",
          "type": "select",
          "selector": "#tel_num_isd_code",
          "value_source": "static",
          "static_value": "91",
          "match_by": "value",
          "explanation": "Country code for the landline — India (91). Separate select from the mobile one; area/STD code and landline number are left blank on purpose."
        },
        {
          "field_id": "passport_num",
          "type": "text",
          "selector": "#passport_num",
          "value_source": "user.passport_number",
          "explanation": "Passport number — mandatory only for non-residents and residents not ordinarily resident. Left blank when the applicant hasn't given one."
        },
        {
          "field_id": "tin_num",
          "type": "text",
          "selector": "#tin_num",
          "value_source": "user.tin_number",
          "explanation": "Taxpayer Identification Number in the country of residence — mandatory only for foreign applicants. Left blank when the applicant hasn't given one."
        }
      ],
      "auto_advance": true
    },
    {
      "step": 4,
      "page_pattern": "endUserLogin",
      "page": "endUserLogin",
      "stepy_index": 3,
      "stop_message": "Declaration filled & saved. Now upload your documents.",
      "fields": [
        {
          "field_id": "proof_dob_code",
          "type": "select",
          "selector": "#proof_dob_code",
          "value_source": "user.proof_of_dob",
          "match_by": "value",
          "explanation": "Proof of date of birth — the document the applicant picked in the panel. Proof of identity and address are auto-set to Aadhaar and disabled by the page under eKYC, so they are not filled here."
        },
        {
          "field_id": "proof_pan_code",
          "type": "select",
          "selector": "#proofOfPanAllotment",
          "value_source": "user.proof_of_pan",
          "match_by": "value",
          "explanation": "Proof of PAN — Copy of Pan Card, Copy of Pan Allotment Letter, or No Document. Correction-form only field."
        },
        {
          "field_id": "verifier_name",
          "type": "text",
          "selector": "#verifierName",
          "value_source": "computed.full_name",
          "explanation": "The \"I/We ___, the applicant\" name in the declaration."
        },
        {
          "field_id": "capacity_verifier",
          "type": "select",
          "selector": "#capacityVerifier",
          "value_source": "static",
          "static_value": "01",
          "match_by": "value",
          "explanation": "Declaration capacity — Self."
        },
        {
          "field_id": "no_of_docs",
          "type": "text",
          "selector": "#noOfDocs",
          "value_source": "static",
          "static_value": "2",
          "explanation": "Number of documents enclosed in support of the proposed corrections. Single-digit field."
        },
        {
          "field_id": "place",
          "type": "text",
          "selector": "#verifierPlace",
          "value_source": "user.place",
          "explanation": "City where the application is being filed. The date beside it is read-only and set by the page."
        },
        {
          "field_id": "save_draft",
          "type": "button_click",
          "selector": "#saveForm",
          "value_source": "static",
          "static_value": true,
          "explanation": "Save Draft — preserves every filled field before the applicant uploads documents. Saves only; it does not submit the application."
        }
      ],
      "completion": {
        "title": "Details filled & saved!",
        "subtitle": "Now upload your documents below",
        "manual_steps": [
          "Upload the documents supporting your <strong>corrections</strong>",
          "Upload your <strong>proof of date of birth</strong>",
          "Check the declaration says <strong>2 documents</strong> — change it if you attached a different number",
          "Click <strong>Submit</strong> when done"
        ]
      }
    }
  ]
}
